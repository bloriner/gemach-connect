generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  password    String
  phone       String?
  city        String?
  state       String?
  bio         String?
  avatarColor String    @default("blue")
  createdAt   DateTime  @default(now())

  gemachs         Gemach[]
  offers          Offer[]        @relation("donor")
  messages        Message[]
  favorites       Favorite[]
  suggestions     Suggestion[]
  threadsAsUser   Thread[]       @relation("threadUser")
  threadsAsOwner  Thread[]       @relation("threadOwner")
}

model Gemach {
  id             String   @id @default(cuid())
  name           String
  category       String
  description    String
  address        String
  city           String
  state          String
  country        String   @default("USA")
  zip            String
  phone          String
  email          String?
  website        String?
  imageUrl       String?
  hours          String   @default("[]")
  needs          String   @default("[]")
  pickupNotes    String?
  dropoff        Boolean  @default(false)
  delivery       Boolean  @default(false)
  apptOnly       Boolean  @default(false)
  verified       Boolean  @default(false)
  familiesHelped Int      @default(0)
  latitude       Float?
  longitude      Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  offers    Offer[]
  threads   Thread[]
  favorites Favorite[]
}

model Offer {
  id            String   @id @default(cuid())
  gemachId       String
  userId        String
  items         String
  qty           Int      @default(1)
  method        String   @default("dropoff")
  preferredDate String?
  note          String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())

  gemach Gemach @relation(fields: [gemachId], references: [id], onDelete: Cascade)
  donor  User   @relation("donor", fields: [userId], references: [id], onDelete: Cascade)
}

model Thread {
  id        String   @id @default(cuid())
  gemachId   String
  ownerId   String
  userId    String
  createdAt DateTime @default(now())

  gemach Gemach @relation(fields: [gemachId], references: [id], onDelete: Cascade)
  owner  User   @relation("threadOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  user   User   @relation("threadUser", fields: [userId], references: [id], onDelete: Cascade)

  messages Message[]
  reads    ThreadRead[]

  @@unique([gemachId, userId])
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User   @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model ThreadRead {
  threadId String
  userId   String
  at       DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@id([threadId, userId])
}

model Suggestion {
  id        String   @id @default(cuid())
  title     String
  body      String
  category  String   @default("general")
  userId    String
  userEmail String
  userName  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Favorite {
  userId   String
  gemachId  String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  gemach Gemach @relation(fields: [gemachId], references: [id], onDelete: Cascade)

  @@id([userId, gemachId])
}
